FROM ubuntu:26.10
ENV DEBIAN_FRONTEND=noninteractive

# Install required packages listed in the manual. This is done separately so that we can
# re-use this fs layer.
RUN set -eux; \
        apt-get update && apt-get install -y --no-install-recommends \
        ${PISM_DEBIAN_PACKAGE_LIST} \
        ; \
        rm -rf /var/lib/apt/lists/*

# Install tools:
# - Cython to build PETSc with petsc4py
# - python3-setuptools is needed to build PETSc with petsc4py
# - wget to download sources of I/O libraries
# - NumPy is used by petsc4py and PISM's scripts
# - SciPy is used by at least one regression test
# - NCO is used by many regression tests
# - PROJ is used by PISM's code computing lon,lat coordinates
# - python3-dev is needed to build Python bindings
# - SWIG is needed to build Python bindings
# - OpenMPI is needed to build PETSc and PISM
# - doxygen and graphviz are needed to build the source code browser
# - various versions of GCC and Clang are used to catch compilation issues
# - latexmk is needed to build the PDF version of the manual
# - Sphinx and sphinxcontrib-bibtex are needed to build the manual
# - build-essential is needed to build .deb packages
# - cdo is used by a regression test
# - ccache used to speed up re-compilation when running tests locally
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
    apt-utils \
    autoconf \
    automake \
    build-essential \
    ccache \
    cdo \
    clang-19 \
    clang-20 \
    clang-21 \
    clang-22 \
    clang-tools-22 \
    cython3 \
    doxygen \
    g++-11 \
    g++-12 \
    g++-13 \
    g++-14 \
    g++-15 \
    g++-16 \
    gcc-11 \
    gcc-12 \
    gcc-13 \
    gcc-14 \
    gcc-15 \
    gcc-16 \
    gfortran \
    graphviz \
    latexmk \
    libfyaml-dev \
    libopenmpi-dev \
    libproj-dev \
    libtool \
    lld \
    m4 \
    make \
    netcdf-bin \
    nco \
    pkg-config \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-venv \
    swig \
    tex-gyre \
    texlive-fonts-recommended \
    texlive-latex-extra \
    texlive-latex-recommended \
    wget \
    libblas-dev \
    liblapack-dev \
    ; \
    rm -rf /var/lib/apt/lists/*


# Create a venv for Python stuff that we don't want to install using apt-get:
RUN python3 -m venv --system-site-packages /usr/local/

# Install Python packages (avoiding apt-get to install newer versions)
RUN <<EOF
    echo "Install Python packages"
    set -eux

    python3 -m pip install \
    mpi4py \
    netCDF4 \
    numpy \
    pyproj \
    scipy \
    sphinx \
    sphinxcontrib-bibtex \
    xarray \
    ;
EOF

# tell OpenMPI that it's OK to run as root (since we're in a Docker container)
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# Build the oldest supported PETSc version. The goal is to check if PISM's C++ code
# compiles with PETSc 3.22. We do not support PISM's Python bindings with old PETSc
# versions, so we build PETSc without petsc4py here.
COPY old-petsc.sh /tmp/
RUN <<EOF
    echo "Install PETSc 3.22"
    set -eux
    cd /tmp && version=3.22.0 build_dir=/tmp/build/petsc ./old-petsc.sh
    rm -rf /tmp/build/petsc
EOF

# Install parallel HDF5, NetCDF and PnetCDF by building them from sources.
#
# Uses wget installed above.
#
# This step uses scripts that are used to describe how to install these libraries in the
# manual. Re-using them here makes it easier to keep this part of the manual up to date.

COPY hdf5.sh /tmp/
RUN <<EOF
    echo "Install HDF5"
    set -eux
    cd /tmp
    build_dir=/tmp/build/netcdf prefix=/usr/local/netcdf-parallel ./hdf5.sh
    rm -rf /tmp/build/netcdf
EOF

COPY pnetcdf.sh /tmp/
RUN <<EOF
    echo "Install PnetCDF"
    set -eux
    cd /tmp
    build_dir=/tmp/build/pnetcdf prefix=/usr/local/netcdf-parallel ./pnetcdf.sh
    rm -rf /tmp/build/pnetcdf
EOF

COPY netcdf.sh /tmp/
RUN <<EOF
    echo "Install NetCDF"
    set -eux
    cd /tmp
    CC=mpicc build_dir=/tmp/build/netcdf lib_dir=/usr/local/netcdf-parallel ./netcdf.sh
    rm -rf /tmp/build/netcdf
EOF

# Build the oldest supported CMake version
COPY cmake-3_20_0.sh /tmp/
RUN <<EOF
    echo "Install CMake 3.20"
    set -eux;
    cd /tmp && build_dir=/tmp/build/cmake prefix=/usr/local/cmake-3.20 ./cmake-3_20_0.sh
    rm -rf /tmp/build/cmake
EOF

# Build the current PETSc version
COPY petsc.sh /tmp/
RUN <<EOF
    echo "Install PETSc"
    set -eux
    cd /tmp && build_dir=/tmp/build/petsc prefix=/usr/local ./petsc.sh
    rm -rf /tmp/build/petsc
EOF

# Build the current PETSc version with 64-bit indices
COPY petsc-64bit.sh /tmp/
RUN <<EOF
    echo "Install PETSc (64-bit indices)"
    set -eux
    cd /tmp && build_dir=/tmp/build/petsc prefix=/usr/local/petsc-64bit ./petsc-64bit.sh
    rm -rf /tmp/build/petsc
EOF

# Build YAXT and YAC
COPY yac.sh /tmp/
RUN <<EOF
    echo "Install YAXT and YAC"
    set -eux
    cd /tmp && build_dir=/tmp/build/yac prefix=/usr/local ./yac.sh
    rm -rf /tmp/build/yac
EOF

RUN ldconfig

RUN useradd --create-home --system --shell=/bin/false builder && usermod --lock builder
USER builder

ARG HOME=/home/builder

# Add petsc4py location to PYTHONPATH:
ENV PYTHONPATH=/usr/local/lib

# Silence OpenMPI warnings:
ENV OMPI_MCA_plm_rsh_agent="" \
    OMPI_MCA_rmaps_base_oversubscribe=yes
